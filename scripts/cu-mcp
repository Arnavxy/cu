#!/bin/zsh
# Source-checkout convenience wrapper; the MCP server itself is Rust.
set -eu
ROOT="${0:A:h:h}"
BIN="$ROOT/cu-runtime/target/release/cu-mcp"
[[ -x "$BIN" ]] || { print -u2 'Build CU first: cargo build --locked --release --manifest-path cu-runtime/Cargo.toml --bins'; exit 127; }
exec "$BIN" "$@"
