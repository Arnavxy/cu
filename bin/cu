#!/bin/zsh
# Source-checkout launcher only. All runtime commands are implemented in Rust.
set -eu
ROOT="${0:A:h:h}"
BIN="$ROOT/cu-runtime/target/release/cu"
[[ -x "$BIN" ]] || { print -u2 'Build CU first: cargo build --locked --release --manifest-path cu-runtime/Cargo.toml'; exit 127; }
exec "$BIN" "$@"
